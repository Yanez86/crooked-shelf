{
	"name": "crooked-shelf",
	"version": "0.9.0",
	"description": "Self-hosted wiki for tabletop RPG campaigns",
	"license": "AGPL-3.0-only",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node server.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"prepare": "svelte-kit sync || echo ''"
	},
	"engines": {
		"node": ">=22.17"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-node": "6.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/better-sqlite3": "7.6.13",
		"@types/leaflet": "1.9.22",
		"@types/node": "22.20.5",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"dependencies": {
		"@fontsource/atkinson-hyperlegible": "5.3.0",
		"@fontsource/opendyslexic": "5.3.0",
		"@node-rs/argon2": "2.2.2",
		"@tiptap/core": "3.32.1",
		"@tiptap/extension-image": "3.32.1",
		"@tiptap/extension-table": "3.32.1",
		"@tiptap/pm": "3.32.1",
		"@tiptap/starter-kit": "3.32.1",
		"@tiptap/suggestion": "3.32.1",
		"better-sqlite3": "12.11.1",
		"diff": "9.0.0",
		"drizzle-orm": "0.45.4",
		"fflate": "0.8.3",
		"image-size": "2.0.4",
		"leaflet": "1.9.4"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	}
}
